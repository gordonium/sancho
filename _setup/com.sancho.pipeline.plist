<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sancho pipeline: earballs sync every 5 minutes (incremental Plaud list; full reconcile on the first run each day). Runs by launchd directly, not via the queue, so 288 runs a day don't bury the results folder; on demand it is `pipeline.sync`.
  INSTALL / REINSTALL: bash ~/Sync/Sancho/_setup/install-mac.sh
  TEST: _setup/tests/install-mac/ and _setup/tests/pipeline/
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sancho.pipeline</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/Sync/Sancho/_setup/pipeline/earballs.sh</string>
    <string>sync</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/sancho-pipeline.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/sancho-pipeline.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
